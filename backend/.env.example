# ==========================================================================
#  Aura Apex Backend — Environment Variables
#  Copy to `.env` and fill in real values. Never commit `.env`.
#  Missing REQUIRED variables cause the server to fail fast on startup.
# ==========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development                 # development | test | staging | production
PORT=5000
API_VERSION=v1
LOG_LEVEL=info                       # trace | debug | info | warn | error | fatal

# --- HTTP ----------------------------------------------------------------
# Comma-separated list of allowed browser origins. Use exact origins in prod.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
JSON_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120                   # general API requests / window / IP
AUTH_RATE_LIMIT_MAX=10               # auth endpoints / window / IP

# --- Supabase (REQUIRED) -------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key            # REQUIRED — used for auth flows (login/register/forgot-password)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key   # REQUIRED — keep secret
SUPABASE_STORAGE_BUCKET=gym-media

# --- Razorpay (optional; payment endpoints disabled if unset) -----------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Uploads -------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=5242880        # 5 MB
